{% extends "base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{% trans "Terms and Conditions" %}{% endblock %}

{% block extra_head %}
<style>
    .legal-page {
        padding: 60px 0 80px;
        background: var(--bg-primary, #0a0e1a);
    }
    .legal-page .container {
        max-width: 820px;
        margin: 0 auto;
        padding: 0 20px;
    }
    .legal-page h1 {
        font-size: var(--fluid-h1);
        font-weight: 900;
        font-family: var(--font-display);
        color: var(--text-white);
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }
    .legal-page h1 span {
        background: var(--gradient-cyber);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .legal-page .subhead {
        color: var(--text-muted);
        font-size: var(--fluid-body);
        margin-bottom: 32px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding-bottom: 16px;
    }
    .legal-page .last-updated {
        color: var(--text-dim);
        font-size: var(--fluid-small);
        margin-top: -20px;
        margin-bottom: 30px;
    }
    .legal-page h2 {
        font-size: var(--fluid-h3);
        font-weight: 700;
        color: var(--text-white);
        margin: 32px 0 12px;
        padding-top: 8px;
        border-top: 1px solid rgba(255,255,255,0.04);
    }
    .legal-page h2:first-of-type {
        border-top: none;
        margin-top: 0;
    }
    .legal-page p, .legal-page li {
        color: var(--text-muted);
        font-size: var(--fluid-body);
        line-height: 1.8;
        margin-bottom: 12px;
    }
    .legal-page ul, .legal-page ol {
        padding-left: 24px;
        margin-bottom: 16px;
    }
    .legal-page li {
        margin-bottom: 6px;
    }
    .legal-page strong {
        color: var(--text-white);
    }
    .legal-page .highlight-box {
        background: rgba(0, 240, 255, 0.04);
        border-left: 4px solid var(--neon-cyan);
        padding: 16px 24px;
        border-radius: var(--radius-sm);
        margin: 20px 0;
    }
    .legal-page .highlight-box p {
        margin: 0;
        color: var(--text-soft);
    }
    .legal-page .highlight-box i {
        color: var(--neon-cyan);
        margin-right: 8px;
    }
    @media (max-width: 768px) {
        .legal-page { padding: 40px 0 60px; }
        .legal-page h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); }
        .legal-page h2 { font-size: clamp(1.2rem, 3vw, 1.6rem); }
    }
</style>
{% endblock %}

{% block content %}
<section class="legal-page">
    <div class="container">
        <h1>{% trans "Terms and" %} <span>{% trans "Conditions" %}</span></h1>
        <div class="subhead">
            {% blocktrans with business_name=business.business_name|default:"Matoshree Cyber Cafe" %}
            Please read these Terms and Conditions carefully before using {{ business_name }}'s services.
            {% endblocktrans %}
        </div>
        <div class="last-updated">
            <i class="fas fa-calendar-alt" aria-hidden="true"></i>
            {% trans "Last updated:" %} {% now "d M Y" %}
        </div>

        <h2>1. {% trans "Acceptance of Terms" %}</h2>
        <p>
            {% blocktrans with business_name=business.business_name|default:"Matoshree Cyber Cafe" %}
            By accessing or using any service provided by {{ business_name }}, you agree to be bound by these Terms and Conditions.
            If you do not agree to all the terms, please do not use our services.
            {% endblocktrans %}
        </p>

        <h2>2. {% trans "Description of Services" %}</h2>
        <p>
            {% trans "We offer a range of digital and cyber services including, but not limited to:" %}
        </p>
        <ul>
            <li>{% trans "Document printing, scanning, and lamination" %}</li>
            <li>{% trans "Online form filling (Aadhaar, PAN, Passport, etc.)" %}</li>
            <li>{% trans "Government scheme applications" %}</li>
            <li>{% trans "Digital payment assistance" %}</li>
            <li>{% trans "Other related cyber services" %}</li>
        </ul>

        <h2>3. {% trans "User Responsibilities" %}</h2>
        <p>
            {% trans "You agree to:" %}
        </p>
        <ul>
            <li>{% trans "Provide accurate and complete information when using our services." %}</li>
            <li>{% trans "Use our services only for lawful purposes." %}</li>
            <li>{% trans "Respect the privacy and rights of other users." %}</li>
            <li>{% trans "Pay all fees and charges as applicable for the services availed." %}</li>
        </ul>

        <h2>4. {% trans "Payments and Refunds" %}</h2>
        <p>
            {% trans "All payments for services are due at the time of service delivery. We accept payments via UPI and cash. Refunds, if any, will be processed according to our refund policy. Please contact us for any payment‑related issues." %}
        </p>

        <h2>5. {% trans "Limitation of Liability" %}</h2>
        <p>
            {% blocktrans with business_name=business.business_name|default:"Matoshree Cyber Cafe" %}
            To the fullest extent permitted by law, {{ business_name }} shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising out of or related to your use of our services. Our total liability shall not exceed the amount paid by you for the specific service in question.
            {% endblocktrans %}
        </p>

        <h2>6. {% trans "Indemnification" %}</h2>
        <p>
            {% trans "You agree to indemnify and hold harmless {{ business_name }} and its employees, agents, and affiliates from any claims, damages, or expenses arising out of your use of our services or your violation of these Terms." %}
        </p>

        <h2>7. {% trans "Changes to These Terms" %}</h2>
        <p>
            {% trans "We reserve the right to update or modify these Terms at any time without prior notice. Your continued use of our services after any changes constitutes your acceptance of the new Terms." %}
        </p>

        <h2>8. {% trans "Governing Law" %}</h2>
        <p>
            {% trans "These Terms shall be governed by and construed in accordance with the laws of India. Any disputes arising under these Terms shall be subject to the exclusive jurisdiction of the courts in Maharashtra, India." %}
        </p>

        <h2>9. {% trans "Contact Us" %}</h2>
        <p>
            {% blocktrans with phone=business.phone|default:"+91 98765 43210" email=business.email|default:"info@matoshree.com" %}
            If you have any questions about these Terms, please contact us at <strong>{{ phone }}</strong> or <strong>{{ email }}</strong>.
            {% endblocktrans %}
        </p>

        <div class="highlight-box">
            <i class="fas fa-check-circle" aria-hidden="true"></i>
            {% trans "By continuing to use our services, you acknowledge that you have read, understood, and agreed to these Terms and Conditions." %}
        </div>
    </div>
</section>
{% endblock %}