# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BASE_URL=http://localhost:8000

# Database - leave unset for local SQLite; use Supabase/Postgres URL in production
DATABASE_URL=
DB_SSL=False

# Media - optional locally, recommended in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email: console, brevo, resend, or smtp
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=
BREVO_API_KEY=
RESEND_API_KEY=

# Payments: manual is the free-first default; use razorpay only if you intentionally enable it
PAYMENT_GATEWAY=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Application settings
GST_RATE=0.18
MAX_UPLOAD_SIZE=10485760
PASSWORD_RESET_TIMEOUT=3600
