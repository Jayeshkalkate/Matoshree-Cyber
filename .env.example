# Copy to .env for local development. Never commit real credentials.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BASE_URL=http://localhost:8000

# Prefer PostgreSQL for deployment. The application falls back to SQLite if omitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=False

# Cloud media storage (optional locally; configure for persistent production uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing email (configure a provider before relying on password resets/contact mail).
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=
BREVO_API_KEY=
RESEND_API_KEY=

# Payments: keep manual mode until verified gateway credentials and webhooks are configured.
PAYMENT_GATEWAY=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional integrations.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/
FILE_ENCRYPTION_KEY=
